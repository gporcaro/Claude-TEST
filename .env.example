# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Gemini
GEMINI_API_KEY=your-gemini-api-key

# Optional
GEMINI_MODEL=gemini-2.5-flash
LOG_LEVEL=INFO

# Channel configuration (optional — enable proactive #help-it listening)
HELP_CHANNEL_ID=

# ServiceNow
SN_INSTANCE_URL=https://yourinstance.service-now.com
SN_USERNAME=your-username
SN_PASSWORD=your-password

# Qdrant vector database (optional — defaults shown)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=it_kb

# Dashboard MFA (required for dashboard auth)
SMTP_EMAIL=your-gmail@gmail.com
SMTP_APP_PASSWORD=your-gmail-app-password
